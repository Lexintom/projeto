{
  "name": "jungle-wagering-processor",
  "version": "1.0.0",
  "description": "API de carteiras e transações de apostas",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "bun run dist/main.js",
    "start:dev": "bun run scripts/dev.ts",
    "start:prod": "bun run dist/main.js",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run scripts/load-test.ts",
    "lint": "eslint src scripts --ext .ts",
    "format": "bunx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migration:generate": "bun run scripts/migration-generate.ts",
    "migration:run": "bun run scripts/migration-run.ts",
    "migration:revert": "bun run scripts/migration-revert.ts",
    "db:schema": "bun run scripts/schema-export.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "typecheck": "tsc --project tsconfig.check.json",
    "docker:reset": "docker compose down -v",
    "test:all": "bun run typecheck && bun run build && bun run lint && bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:docker": "docker compose --profile test run --build --rm tests"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.3.0",
    "@mikro-orm/migrations": "^6.3.0",
    "@mikro-orm/nestjs": "6.1.1",
    "@mikro-orm/postgresql": "^6.3.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/terminus": "^10.2.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/client-sts": "^3.600.0",
    "decimal.js": "^10.4.3",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.0",
    "@nestjs/swagger": "^7.4.2",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "ajv": "8.20.0",
    "fastify": "4.28.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^20.12.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "trustedDependencies": [
    "@mikro-orm/core",
    "@nestjs/core",
    "decimal.js"
  ],
  "engines": {
    "bun": ">=1.1.0 <2"
  }
}
