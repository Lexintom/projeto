# Configuração para rodar a API fora do Docker.
NODE_ENV=development
PORT=3000
APP_NAME=jungle-wagering-processor

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=jungle
DATABASE_PASSWORD=jungle_secret
DATABASE_NAME=jungle_gaming
DATABASE_SSL=false
DATABASE_POOL_SIZE=20

SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
SQS_ACCESS_KEY_ID=test
SQS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_VISIBILITY_TIMEOUT=60
SQS_CONSUMER_NAME=wager-processor

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=60000

LOG_LEVEL=info
LOG_PRETTY=false
METRICS_ENABLED=true
HEALTH_DB_TIMEOUT_MS=5000
HEALTH_SQS_TIMEOUT_MS=5000

# JWT ainda não implementado. Se habilitar, as rotas protegidas recusam acesso.
AUTH_ENABLED=false
